QUERY: What measurements have been taken for the Parthenon?
======================================================================

────────────────────────────────────────────────────────────
[Step 1] Semantic parsing: 'What measurements have been taken for the Parthenon?'
[Step 1] Intent: {
  "target_class": "Asset",
  "filters": [
    {
      "property": "name",
      "op": "contains",
      "value": "Parthenon"
    }
  ],
  "return_properties": [
    "name",
    "country"
  ],
  "joins": [
    {
      "class": "Measurement",
      "via": "measures",
      "direction": "incoming",
      "return_properties": [
        "name",
        "quantity_value",
        "quantity_unit"
      ],
      "filters": []
    }
  ],
  "explanation": "Find the Asset named Parthenon and retrieve its related Measurement records."
}

────────────────────────────────────────────────────────────
[Step 3] SPARQL query:
PREFIX pan:  <http://www.argus-project.eu/>
PREFIX inst: <http://www.argus-project.eu/instance/>
PREFIX geo:  <http://www.opengis.net/ont/geosparql#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?asset ?name ?country ?measurement ?Measurement_name ?Measurement_quantity_value ?Measurement_quantity_unit
WHERE {
  ?asset a pan:Asset .
  OPTIONAL { ?asset pan:name ?name . }
  OPTIONAL { ?asset pan:country ?country . }
  ?asset pan:name ?_f_name .
  FILTER(CONTAINS(LCASE(STR(?_f_name)), LCASE("Parthenon")))
  OPTIONAL {
    ?measurement pan:measures ?asset .
    ?measurement a pan:Measurement .
    OPTIONAL { ?measurement pan:name ?Measurement_name . }
    OPTIONAL { ?measurement pan:quantity_value ?Measurement_quantity_value . }
    OPTIONAL { ?measurement pan:quantity_unit ?Measurement_quantity_unit . }
  }
}
