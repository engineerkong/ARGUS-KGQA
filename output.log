  "explanation": "List temperature readings (hasSimpleResult) for each site by joining ObservationCollection \u2192 Observation \u2192 ObservedProperty (filtered on temperature) and Site."
}

────────────────────────────────────────────────────────────
[Step 2] SPARQL query:
PREFIX sosa:  <http://www.w3.org/ns/sosa/>
PREFIX argus: <http://www.argus-project.eu/ontology/>
PREFIX ex:    <http://www.argus-project.eu/resource/>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>
PREFIX rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT DISTINCT ?observation_hassimpleresult ?observedproperty_label ?site_label
WHERE {
  ?observationcollection a sosa:ObservationCollection .
    ?observationcollection argus:hasObservation ?observation .
    OPTIONAL { ?observation sosa:hasSimpleResult ?observation_hassimpleresult . }
    ?observation sosa:observedProperty ?observedproperty .
    OPTIONAL { ?observedproperty rdfs:label ?observedproperty_label . }
    ?observedproperty rdfs:label ?_jf_label .
      FILTER(CONTAINS(LCASE(STR(?_jf_label)), LCASE("temperature")))
  OPTIONAL {
    ?observationcollection argus:hasSite ?site .
    OPTIONAL { ?site rdfs:label ?site_label . }
  }
}
