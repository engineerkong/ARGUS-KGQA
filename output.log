======================================================================
QUERY: Find Byzantine-style heritage sites and list any threats associated with them.
======================================================================

────────────────────────────────────────────────────────────
[Step 1] Semantic parsing: 'Find Byzantine-style heritage sites and list any threats associated with them.'
[Step 1] Intent: {
  "target_class": "Asset",
  "filters": [
    {
      "property": "architectural_style",
      "op": "contains",
      "value": "Byzantine"
    }
  ],
  "return_properties": [
    "name",
    "country",
    "architectural_style"
  ],
  "joins": [
    {
      "class": "Threat",
      "via": "isTriggeredBy",
      "direction": "outgoing",
      "return_properties": [
        "threat_description",
        "threat_level"
      ],
      "filters": []
    }
  ],
  "explanation": "Select assets with Byzantine architectural style and retrieve their associated threats."
}

────────────────────────────────────────────────────────────
[Step 3] SPARQL query:
PREFIX pan:  <http://www.argus-project.eu/>
PREFIX inst: <http://www.argus-project.eu/instance/>
PREFIX geo:  <http://www.opengis.net/ont/geosparql#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?asset ?name ?country ?architectural_style ?threat ?Threat_threat_description ?Threat_threat_level
WHERE {
  ?asset a pan:Asset .
  OPTIONAL { ?asset pan:name ?name . }
  OPTIONAL { ?asset pan:country ?country . }
  OPTIONAL { ?asset pan:architectural_style ?architectural_style . }
  ?asset pan:architectural_style ?_f_architectural_style .
  FILTER(CONTAINS(LCASE(STR(?_f_architectural_style)), LCASE("Byzantine")))
  OPTIONAL {
    ?asset pan:isTriggeredBy ?threat .
    ?threat a pan:Threat .
    OPTIONAL { ?threat pan:threat_description ?Threat_threat_description . }
    OPTIONAL { ?threat pan:threat_level ?Threat_threat_level . }
  }
}
