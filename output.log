QUERY: Which assets are at risk from earthquakes and what is their risk magnitude?
======================================================================

────────────────────────────────────────────────────────────
[Step 1] Semantic parsing: 'Which assets are at risk from earthquakes and what is their risk magnitude?'
[Step 1] Intent: {
  "target_class": "Asset",
  "filters": [],
  "return_properties": [
    "name",
    "country"
  ],
  "joins": [
    {
      "class": "Threat",
      "via": "isTriggeredBy",
      "direction": "outgoing",
      "return_properties": [],
      "filters": [
        {
          "property": "threat_description",
          "op": "contains",
          "value": "earthquake"
        }
      ]
    },
    {
      "class": "RiskAssessment",
      "via": "assessesRiskFor",
      "direction": "incoming",
      "return_properties": [
        "MagnitudeOfRisk"
      ],
      "filters": []
    }
  ],
  "explanation": "Find assets linked to earthquake threats and retrieve their associated risk magnitude."
}

────────────────────────────────────────────────────────────
[Step 3] SPARQL query:
PREFIX pan:  <http://www.argus-project.eu/>
PREFIX inst: <http://www.argus-project.eu/instance/>
PREFIX geo:  <http://www.opengis.net/ont/geosparql#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?asset ?name ?country ?threat ?riskassessment ?RiskAssessment_MagnitudeOfRisk
WHERE {
  ?asset a pan:Asset .
  OPTIONAL { ?asset pan:name ?name . }
  OPTIONAL { ?asset pan:country ?country . }
  OPTIONAL {
    ?asset pan:isTriggeredBy ?threat .
    ?threat a pan:Threat .
    ?threat pan:threat_description ?_jf_threat_description .
      FILTER(CONTAINS(LCASE(STR(?_jf_threat_description)), LCASE("earthquake")))
  }
  OPTIONAL {
    ?riskassessment pan:assessesRiskFor ?asset .
    ?riskassessment a pan:RiskAssessment .
    OPTIONAL { ?riskassessment pan:MagnitudeOfRisk ?RiskAssessment_MagnitudeOfRisk . }
  }
}
