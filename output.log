PREFIX sosa:  <http://www.w3.org/ns/sosa/>
PREFIX argus: <http://www.argus-project.eu/ontology/>
PREFIX ex:    <http://www.argus-project.eu/resource/>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>
PREFIX rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT DISTINCT ?resulttime ?observation_hassimpleresult ?site_label
WHERE {
  {
  SELECT ?observationcollection ?resulttime
  WHERE {
    ?observationcollection a sosa:ObservationCollection .
    OPTIONAL { ?observationcollection sosa:resultTime ?resulttime . }
  }
    ORDER BY DESC(?resulttime)
  LIMIT 10
  }
  OPTIONAL {
    ?observationcollection argus:hasObservation ?observation .
    OPTIONAL { ?observation sosa:hasSimpleResult ?observation_hassimpleresult . }
  }
  OPTIONAL {
    ?observationcollection argus:hasSite ?site .
    OPTIONAL { ?site rdfs:label ?site_label . }
  }
}
