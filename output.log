QUERY: Show me all cultural heritage sites in Italy and their current condition.
======================================================================

────────────────────────────────────────────────────────────
[Step 1] Semantic parsing: 'Show me all cultural heritage sites in Italy and their current condition.'
[Step 1] Intent: {
  "target_class": "Asset",
  "filters": [
    {
      "property": "country",
      "op": "equals",
      "value": "Italy"
    }
  ],
  "return_properties": [
    "name",
    "current_condition"
  ],
  "joins": [],
  "explanation": "Retrieve all Asset instances located in Italy and return their name and current condition."
}

────────────────────────────────────────────────────────────
[Step 3] SPARQL query:
PREFIX pan:  <http://www.argus-project.eu/>
PREFIX inst: <http://www.argus-project.eu/instance/>
PREFIX geo:  <http://www.opengis.net/ont/geosparql#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?asset ?name ?current_condition
WHERE {
  ?asset a pan:Asset .
  OPTIONAL { ?asset pan:name ?name . }
  OPTIONAL { ?asset pan:current_condition ?current_condition . }
  ?asset pan:country ?_f_country .
  FILTER(LCASE(STR(?_f_country)) = LCASE("Italy"))
}
