<?xml version="1.0"?>
<rdf:RDF 
     xmlns="http://www.heritage-kg.example.org/panoptes#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:sosa="http://www.w3.org/ns/sosa/"
     xmlns:ssn="http://www.w3.org/ns/ssn/"
     xmlns:geo="http://www.opengis.net/ont/geosparql#"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:time="http://www.w3.org/2006/time#"
     xmlns:crm="http://www.cidoc-crm.org/cidoc-crm/"
     xmlns:dul="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#"
     xml:base="http://www.heritage-kg.example.org/panoptes">

  <owl:Ontology rdf:about="http://www.heritage-kg.example.org/panoptes">
    <dc:title>HERIKG Ontology</dc:title>
    <dc:creator>HERIKG Project Consortium</dc:creator>
    <dc:description>
      HERIKG Panoptes ontology, integrating standard ontologies (SOSA/SSN, PROV, CIDOC-CRM, GeoSPARQL, OWL-Time, Dublin Core, DUL).
    </dc:description>
    <owl:versionInfo>0.1</owl:versionInfo>
    <!-- Enable/Disable for usage/visualization -->
    <!-- <owl:imports rdf:resource="http://www.w3.org/2000/01/rdf-schema#"/>-->
    <!-- <owl:imports rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#"/> -->
    <!-- <owl:imports rdf:resource="http://www.w3.org/2002/07/owl#"/>-->
    <!-- <owl:imports rdf:resource="http://purl.org/dc/elements/1.1/"/>-->
    <!-- <owl:imports rdf:resource="http://www.w3.org/2001/XMLSchema#"/>-->
    <!-- <owl:imports rdf:resource="http://www.w3.org/ns/sosa/"/>-->
    <!-- <owl:imports rdf:resource="http://www.w3.org/ns/ssn/"/>-->
    <!-- <owl:imports rdf:resource="http://www.opengis.net/ont/geosparql#"/>-->
    <!-- <owl:imports rdf:resource="http://www.w3.org/ns/prov#"/>-->
    <!-- <owl:imports rdf:resource="http://www.w3.org/2006/time#"/>-->
    <!-- <owl:imports rdf:resource="http://www.cidoc-crm.org/cidoc-crm/"/>-->
    <!-- <owl:imports rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#"/>-->

  </owl:Ontology>

  <!-- Classes -->

  <owl:Class rdf:about="Asset">
    <rdfs:label>Asset</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="AssetInSpaceTime">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
    <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
    <rdfs:label>Asset in Space-Time</rdfs:label>
  </owl:Class>
    <!-- Link Asset to its spatiotemporal representation -->
    <owl:ObjectProperty rdf:about="hasSpatiotemporalRepresentation">
      <rdfs:domain rdf:resource="Asset"/>
      <rdfs:range rdf:resource="AssetInSpaceTime"/>
      <rdfs:label>has spatiotemporal representation</rdfs:label>
    </owl:ObjectProperty>

  <owl:Class rdf:about="Measurement">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
    <rdfs:label>Measurement</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="Instrument">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
    <rdfs:label>Instrument</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="Quantity">
    <rdfs:label>Quantity</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="Prediction">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label>Prediction</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="ComputationalModel">
    <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Method"/>
    <rdfs:comment>A computational method or algorithm.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="Visualization">
    <rdfs:label>Visualization</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="PolicyEventLink">
    <rdfs:label>PolicyEventLink</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="DecisionContext">
    <rdfs:label>DecisionContext</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="Protocol">
    <rdfs:label>Protocol</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="Policy">
    <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Policy"/>
  </owl:Class>

  <owl:Class rdf:about="Decision">
    <rdfs:label>Decision</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Decision"/>
    <rdfs:comment>A decision-making action modeled both as a PROV activity and a DUL decision act.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="Threat">
    <rdfs:label>Threat</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="RiskAssessment">
    <rdfs:label>Risk Assessment</rdfs:label>
    <rdfs:comment>A structured evaluation of risk using the ABC method: Frequency (A), Loss (B), Items Affected (C).</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="CulturalDocumentation">
    <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E31_Document"/>
    <rdfs:label>Cultural Documentation</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="Event">
    <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E5_Event"/>
    <rdfs:label>Event</rdfs:label>
  </owl:Class>

  <!-- GeoSPARQL Geometry class (fallback declaration) -->
  <owl:Class rdf:about="http://www.opengis.net/ont/geosparql#Geometry">
    <rdfs:label>Geometry</rdfs:label>
  </owl:Class>







  <!-- Object Properties -->

  <!-- Local copies of GeoSPARQL properties to avoid WebVOWL 'Thing' -->
  <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#hasGeometry">
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
    <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
    <rdfs:label>has geometry</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#sfWithin">
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
    <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
    <rdfs:label>spatially within</rdfs:label>
  </owl:ObjectProperty>

  <!-- Link AssetInSpaceTime to a GeoSPARQL Geometry -->
  <owl:ObjectProperty rdf:about="hasAssetLocation">
    <rdfs:subPropertyOf rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
    <rdfs:domain rdf:resource="AssetInSpaceTime"/>
    <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
    <rdfs:label>has Asset location</rdfs:label>
  </owl:ObjectProperty>

  <!-- For spatial analysis -->
  <owl:ObjectProperty rdf:about="isWithinFootprint">
    <rdfs:subPropertyOf rdf:resource="http://www.opengis.net/ont/geosparql#sfWithin"/>
    <rdfs:domain rdf:resource="AssetInSpaceTime"/>
    <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
    <rdfs:label>is within footprint</rdfs:label>
  </owl:ObjectProperty>

  <!-- Link Measurement to its sensor's location (if mobile) -->
  <owl:ObjectProperty rdf:about="hasSensorLocation">
    <rdfs:domain rdf:resource="Measurement"/>
    <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
    <rdfs:label>has sensor location</rdfs:label>
  </owl:ObjectProperty>

  <!-- Link Measurement to a timestamp -->
  <owl:ObjectProperty rdf:about="hasTime">
    <rdfs:domain rdf:resource="Measurement"/>
    <rdfs:range rdf:resource="http://www.w3.org/2006/time#Instant"/>
    <rdfs:label>has time</rdfs:label>
  </owl:ObjectProperty>

  <!-- Timestamping for core outputs using OWL-Time -->
  <owl:ObjectProperty rdf:about="eventTime">
    <rdfs:domain rdf:resource="Event"/>
    <rdfs:range rdf:resource="http://www.w3.org/2006/time#Instant"/>
    <rdfs:label>event time</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="threatTime">
    <rdfs:domain rdf:resource="Threat"/>
    <rdfs:range rdf:resource="http://www.w3.org/2006/time#Instant"/>
    <rdfs:label>threat time</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="decisionTime">
    <rdfs:domain rdf:resource="Decision"/>
    <rdfs:range rdf:resource="http://www.w3.org/2006/time#Instant"/>
    <rdfs:label>decision time</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="predictionTime">
    <rdfs:domain rdf:resource="Prediction"/>
    <rdfs:range rdf:resource="http://www.w3.org/2006/time#Instant"/>
    <rdfs:label>prediction time</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="policyValidSince">
    <rdfs:domain rdf:resource="Policy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2006/time#Instant"/>
    <rdfs:label>policy valid since</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="policyValidUntil">
    <rdfs:domain rdf:resource="Policy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2006/time#Instant"/>
    <rdfs:label>policy valid until</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="hasPolicy">
    <rdfs:domain rdf:resource="PolicyEventLink"/>
    <rdfs:range rdf:resource="Policy"/>
    <rdfs:label>has policy</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="hasEvent">
    <rdfs:domain rdf:resource="PolicyEventLink"/>
    <rdfs:range rdf:resource="Event"/>
    <rdfs:label>has event</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="generatesThreat">
    <rdfs:domain rdf:resource="PolicyEventLink"/>
    <rdfs:range rdf:resource="Threat"/>
    <rdfs:label>generates threat</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="usesPrediction">
    <rdfs:domain rdf:resource="DecisionContext"/>
    <rdfs:range rdf:resource="Prediction"/>
    <rdfs:label>uses prediction</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="guidedByPolicy">
    <rdfs:domain rdf:resource="DecisionContext"/>
    <rdfs:range rdf:resource="Policy"/>
    <rdfs:label>guided by policy</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="resultsInDecision">
    <rdfs:domain rdf:resource="DecisionContext"/>
    <rdfs:range rdf:resource="Decision"/>
    <rdfs:label>results in decision</rdfs:label>
  </owl:ObjectProperty>
    
  <owl:ObjectProperty rdf:about="isTriggeredBy">
    <rdfs:domain rdf:resource="Event"/>
    <rdfs:range rdf:resource="ComputationalModel"/>
  </owl:ObjectProperty>
  
  <owl:ObjectProperty rdf:about="isPredictedBy">
    <rdfs:domain rdf:resource="Prediction"/>
    <rdfs:range rdf:resource="ComputationalModel"/>
  </owl:ObjectProperty>
  
  <owl:ObjectProperty rdf:about="isModeledBy">
    <rdfs:domain rdf:resource="ComputationalModel"/>
    <rdfs:range rdf:resource="AssetInSpaceTime"/>
  </owl:ObjectProperty>
  
  <owl:ObjectProperty rdf:about="visualizes">
    <rdfs:domain rdf:resource="Visualization"/>
    <rdfs:range rdf:resource="ComputationalModel"/>
  </owl:ObjectProperty>
    
  <owl:ObjectProperty rdf:about="documents">
    <rdfs:domain rdf:resource="CulturalDocumentation"/>
    <rdfs:range rdf:resource="Asset"/>
  </owl:ObjectProperty>
  
  <owl:ObjectProperty rdf:about="measures">
    <rdfs:domain rdf:resource="Measurement"/>
    <rdfs:range rdf:resource="AssetInSpaceTime"/>
  </owl:ObjectProperty>
  
  <owl:ObjectProperty rdf:about="quantifies">
    <rdfs:domain rdf:resource="Quantity"/>
    <rdfs:range rdf:resource="Measurement"/>
  </owl:ObjectProperty>
  
  <owl:ObjectProperty rdf:about="followsProtocol">
    <rdfs:domain rdf:resource="Measurement"/>
    <rdfs:range rdf:resource="Protocol"/>
  </owl:ObjectProperty>
  
  <owl:ObjectProperty rdf:about="usesInstrument">
    <rdfs:domain rdf:resource="Protocol"/>
    <rdfs:range rdf:resource="Instrument"/>
  </owl:ObjectProperty>
    
  <owl:ObjectProperty rdf:about="hasMeasurement">
    <rdfs:domain rdf:resource="ComputationalModel"/>
    <rdfs:range rdf:resource="Measurement"/>
  </owl:ObjectProperty>








  <!-- Datatype Properties -->
  <owl:ObjectProperty rdf:about="informsPolicy">
    <rdfs:domain rdf:resource="RiskAssessment"/>
    <rdfs:range rdf:resource="Policy"/>
    <rdfs:label>informs policy</rdfs:label>
  </owl:ObjectProperty>

  <!-- For satellites -->
  <owl:DatatypeProperty rdf:about="orbital_altitude">
    <rdfs:domain rdf:resource="Instrument"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="decision_description">
    <rdfs:domain rdf:resource="Decision"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="policy_name">
    <rdfs:domain rdf:resource="Policy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>


  <owl:DatatypeProperty rdf:about="event_date">
    <rdfs:domain rdf:resource="Event"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="threat_level">
    <rdfs:domain rdf:resource="Threat"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="threat_description">
    <rdfs:domain rdf:resource="Threat"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="prediction_outcome">
    <rdfs:domain rdf:resource="Prediction"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="prediction_confidence">
    <rdfs:domain rdf:resource="Prediction"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="forecast_time_horizon">
    <rdfs:domain rdf:resource="Prediction"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="prediction_date">
    <rdfs:domain rdf:resource="Prediction"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="model_name">
    <rdfs:domain rdf:resource="ComputationalModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="model_version">
    <rdfs:domain rdf:resource="ComputationalModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="calibration_date">
    <rdfs:domain rdf:resource="ComputationalModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="source_code_URL">
    <rdfs:domain rdf:resource="ComputationalModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <!-- Optionally, you could use xsd:anyURI -->
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="name">
    <rdfs:domain rdf:resource="Asset"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="country">
    <rdfs:domain rdf:resource="Asset"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="coordinates">
    <rdfs:domain rdf:resource="Asset"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="construction_period">
    <rdfs:domain rdf:resource="Asset"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="architectural_style">
    <rdfs:domain rdf:resource="Asset"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="material_used">
    <rdfs:domain rdf:resource="Asset"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="current_condition">
    <rdfs:domain rdf:resource="Asset"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="visualization_type">
    <rdfs:domain rdf:resource="Visualization"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="file_format">
    <rdfs:domain rdf:resource="Visualization"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="resolution">
    <rdfs:domain rdf:resource="Visualization"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="documentation_title">
    <rdfs:domain rdf:resource="CulturalDocumentation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="creation_date">
    <rdfs:domain rdf:resource="CulturalDocumentation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="format">
    <rdfs:domain rdf:resource="CulturalDocumentation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="language">
    <rdfs:domain rdf:resource="CulturalDocumentation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="quantity_value">
    <rdfs:domain rdf:resource="Quantity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="quantity_unit">
    <rdfs:domain rdf:resource="Quantity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="protocol_name">
    <rdfs:domain rdf:resource="Protocol"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="instrument_name">
    <rdfs:domain rdf:resource="Instrument"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="manufacturer">
    <rdfs:domain rdf:resource="Instrument"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="serialNumber">
    <rdfs:domain rdf:resource="Instrument"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>




  <!-- Datatype Properties for RiskAssessment ABC method -->
  <owl:DatatypeProperty rdf:about="FrequencyA">
    <rdfs:domain rdf:resource="RiskAssessment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label>Risk Frequency (A)</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="LossB">
    <rdfs:domain rdf:resource="RiskAssessment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label>Risk Loss (B)</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="FractionC">
    <rdfs:domain rdf:resource="RiskAssessment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label>Items Affected (C)</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="MagnitudeOfRisk">
    <rdfs:domain rdf:resource="RiskAssessment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label>Magnitude of Risk (MR)</rdfs:label>
  </owl:DatatypeProperty>

  <!-- Object Properties for RiskAssessment -->
  <owl:ObjectProperty rdf:about="assessesRiskFor">
    <rdfs:domain rdf:resource="RiskAssessment"/>
    <rdfs:range rdf:resource="Asset"/>
    <rdfs:label>assesses risk for</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="relatedThreat">
    <rdfs:domain rdf:resource="RiskAssessment"/>
    <rdfs:range rdf:resource="Threat"/>
    <rdfs:label>related threat</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="assessmentTime">
    <rdfs:domain rdf:resource="RiskAssessment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2006/time#Instant"/>
    <rdfs:label>assessment time</rdfs:label>
  </owl:ObjectProperty>

</rdf:RDF>