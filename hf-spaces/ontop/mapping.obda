[PrefixDeclaration]
sosa:     http://www.w3.org/ns/sosa/
herikg:    http://www.heritage-kg.example.org/ontology/
panoptes: http://www.heritage-kg.example.org/panoptes#
ex:       http://www.heritage-kg.example.org/resource/
rdfs:     http://www.w3.org/2000/01/rdf-schema#
xsd:      http://www.w3.org/2001/XMLSchema#

[MappingDeclaration] @collection [[

mappingId   site
target      ex:site/{site_id} a herikg:Site ; rdfs:label {label} .
source      SELECT site_id, label FROM sites

mappingId   node
target      ex:node/{node_id} a herikg:Node ; rdfs:label {label} ; herikg:nodeId {node_id} ;
            herikg:nodeName {name} ; herikg:nodeModel {model} ;
            herikg:latitude {latitude}^^xsd:decimal ; herikg:longitude {longitude}^^xsd:decimal ;
            herikg:altitude {altitude}^^xsd:decimal .
source      SELECT node_id, label, name, model, latitude, longitude, altitude FROM nodes

mappingId   sensor
target      ex:sensor/{sensor_id} a sosa:Sensor ; rdfs:label {label} ;
            herikg:sensorId {sensor_id} ; herikg:sensorModel {model} .
source      SELECT sensor_id, label, model FROM sensors

mappingId   observed_property
target      ex:quantity/{property_id} a herikg:ObservedProperty ; rdfs:label {label} .
source      SELECT property_id, label FROM observed_properties

mappingId   reading
target      ex:reading/{reading_id} a sosa:ObservationCollection ;
            herikg:hasSite ex:site/{site_id} ; sosa:madeBySensor ex:sensor/{sensor_id} ;
            herikg:hasNode ex:node/{node_id} ; sosa:resultTime {result_time}^^xsd:dateTime ;
            herikg:readingType {reading_type} ; herikg:topic {topic} ;
            herikg:topicId {topic_id} ; herikg:deviceGroupId {device_group_id} .
source      SELECT reading_id, site_id, sensor_id, node_id, result_time,
                   reading_type, topic, topic_id, device_group_id FROM readings

mappingId   reading_has_observation
target      ex:reading/{reading_id} herikg:hasObservation ex:observation/{observation_id} .
source      SELECT reading_id, observation_id FROM observations

mappingId   observation_numeric
target      ex:observation/{observation_id} a sosa:Observation ;
            sosa:observedProperty ex:quantity/{property_id} ;
            sosa:hasSimpleResult {value}^^xsd:decimal ;
            sosa:resultTime {result_time}^^xsd:dateTime ; herikg:unit {unit} .
source      SELECT observation_id, property_id, value, result_time, unit
                   FROM observations WHERE value IS NOT NULL

mappingId   observation_text
target      ex:observation/{observation_id} a sosa:Observation ;
            sosa:observedProperty ex:quantity/{property_id} ;
            sosa:hasSimpleResult {value_text} ;
            sosa:resultTime {result_time}^^xsd:dateTime ; herikg:unit {unit} .
source      SELECT observation_id, property_id, value_text, result_time, unit
                   FROM observations WHERE value_text IS NOT NULL

mappingId   threat
target      ex:threat/{threat_id} a panoptes:Threat ; rdfs:label {label} .
source      SELECT threat_id, label FROM threats

mappingId   threat_description
target      ex:threat/{threat_id} herikg:threatDescription {description} .
source      SELECT threat_id, description FROM threats WHERE description IS NOT NULL

mappingId   threat_level
target      ex:threat/{threat_id} herikg:threatLevel {threat_level} .
source      SELECT threat_id, threat_level FROM threats WHERE threat_level IS NOT NULL

mappingId   policy
target      ex:policy/{policy_id} a panoptes:Policy ; rdfs:label {label} .
source      SELECT policy_id, label FROM policies

mappingId   policy_description
target      ex:policy/{policy_id} herikg:policyDescription {description} .
source      SELECT policy_id, description FROM policies WHERE description IS NOT NULL

mappingId   policy_rule_id
target      ex:policy/{policy_id} herikg:ruleId {rule_id} .
source      SELECT policy_id, rule_id FROM policies WHERE rule_id IS NOT NULL

mappingId   policy_threat_name
target      ex:policy/{policy_id} herikg:threatName {threat_name} .
source      SELECT policy_id, threat_name FROM policies WHERE threat_name IS NOT NULL

mappingId   policy_threshold_value
target      ex:policy/{policy_id} herikg:thresholdValue {threshold_value}^^xsd:decimal .
source      SELECT policy_id, threshold_value FROM policies WHERE threshold_value IS NOT NULL

mappingId   policy_threshold_json
target      ex:policy/{policy_id} herikg:thresholdJson {threshold_json} .
source      SELECT policy_id, threshold_json FROM policies WHERE threshold_json IS NOT NULL

mappingId   policy_site
target      ex:policy/{policy_id} herikg:appliesToSite ex:site/{site_id} .
source      SELECT policy_id, site_id FROM policies WHERE site_id IS NOT NULL

mappingId   decision
target      ex:decision/{decision_id} a panoptes:Decision ; rdfs:label {label} .
source      SELECT decision_id, label FROM decisions

mappingId   decision_description
target      ex:decision/{decision_id} herikg:decisionDescription {description} .
source      SELECT decision_id, description FROM decisions WHERE description IS NOT NULL

mappingId   decision_urgency
target      ex:decision/{decision_id} herikg:urgency {urgency} .
source      SELECT decision_id, urgency FROM decisions WHERE urgency IS NOT NULL

mappingId   asset
target      ex:asset/{asset_id} a panoptes:Asset ; rdfs:label {label} .
source      SELECT asset_id, label FROM assets

mappingId   asset_description
target      ex:asset/{asset_id} herikg:assetDescription {description} .
source      SELECT asset_id, description FROM assets WHERE description IS NOT NULL

mappingId   asset_code
target      ex:asset/{asset_id} herikg:assetCode {asset_code} .
source      SELECT asset_id, asset_code FROM assets WHERE asset_code IS NOT NULL

mappingId   asset_pilot_number
target      ex:asset/{asset_id} herikg:pilotNumber {pilot_number}^^xsd:integer .
source      SELECT asset_id, pilot_number FROM assets WHERE pilot_number IS NOT NULL

mappingId   asset_country
target      ex:asset/{asset_id} herikg:country {country} .
source      SELECT asset_id, country FROM assets WHERE country IS NOT NULL

mappingId   asset_source_url
target      ex:asset/{asset_id} herikg:sourceUrl {source_url} .
source      SELECT asset_id, source_url FROM assets WHERE source_url IS NOT NULL

mappingId   asset_site
target      ex:asset/{asset_id} herikg:atSite ex:site/{site_id} .
source      SELECT asset_id, site_id FROM assets WHERE site_id IS NOT NULL

mappingId   physical_quantity_dual_type
target      ex:quantity/{property_id} a herikg:PhysicalQuantity .
source      SELECT property_id FROM observed_properties

mappingId   location
target      ex:location/{site_id} a herikg:Location ; rdfs:label {label}^^xsd:string .
source      SELECT site_id, label FROM sites

mappingId   asset_state
target      ex:asset-state/{site_id} a herikg:AssetState ; rdfs:label {label}^^xsd:string ;
            herikg:hasLocation ex:location/{site_id} .
source      SELECT site_id, label FROM sites

mappingId   asset_state_of_asset
target      ex:asset-state/{site_id} herikg:stateOfAsset ex:asset/{asset_id} .
source      SELECT site_id, asset_id FROM assets WHERE site_id IS NOT NULL

mappingId   device_type
target      ex:device-type/{model} a herikg:DeviceType ; rdfs:label {model}^^xsd:string .
source      SELECT DISTINCT model FROM nodes WHERE model IS NOT NULL

mappingId   device
target      ex:device/{node_id} a herikg:Device ; rdfs:label {label}^^xsd:string .
source      SELECT node_id, label FROM nodes

mappingId   device_has_type
target      ex:device/{node_id} herikg:deviceType ex:device-type/{model} .
source      SELECT node_id, model FROM nodes WHERE model IS NOT NULL

mappingId   installed_device
target      ex:installed-device/{node_id} a herikg:InstalledDevice ; rdfs:label {label}^^xsd:string ;
            herikg:installsDevice ex:device/{node_id} ; herikg:installedOnAssetState ex:asset-state/{site_id} .
source      SELECT DISTINCT n.node_id, n.label, r.site_id
                   FROM nodes n JOIN readings r ON r.node_id = n.node_id

mappingId   instrument_type
target      ex:instrument-type/{model} a herikg:InstrumentType ; rdfs:label {model}^^xsd:string .
source      SELECT DISTINCT model FROM sensors WHERE model IS NOT NULL

mappingId   instrument
target      ex:instrument/{sensor_id} a herikg:Instrument ; rdfs:label {label}^^xsd:string .
source      SELECT sensor_id, label FROM sensors

mappingId   instrument_has_type
target      ex:instrument/{sensor_id} herikg:instrumentType ex:instrument-type/{model} .
source      SELECT sensor_id, model FROM sensors WHERE model IS NOT NULL

mappingId   installed_instrument
target      ex:installed-instrument/{sensor_id} a herikg:InstalledInstrument ; rdfs:label {label}^^xsd:string ;
            herikg:installsInstrument ex:instrument/{sensor_id} ; herikg:installedOnDevice ex:installed-device/{node_id} .
source      SELECT DISTINCT s.sensor_id, s.label, r.node_id
                   FROM sensors s JOIN readings r ON r.sensor_id = s.sensor_id

mappingId   observation_numeric_installed_instrument
target      ex:observation/{observation_id} sosa:madeBySensor ex:installed-instrument/{sensor_id} .
source      SELECT o.observation_id, r.sensor_id
                   FROM observations o JOIN readings r ON r.reading_id = o.reading_id
                   WHERE o.value IS NOT NULL

mappingId   observation_text_installed_instrument
target      ex:observation/{observation_id} sosa:madeBySensor ex:installed-instrument/{sensor_id} .
source      SELECT o.observation_id, r.sensor_id
                   FROM observations o JOIN readings r ON r.reading_id = o.reading_id
                   WHERE o.value_text IS NOT NULL

]]
