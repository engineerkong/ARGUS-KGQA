PREFIX sosa:  <http://www.w3.org/ns/sosa/>
PREFIX argus: <http://www.argus-project.eu/ontology/>
PREFIX ex:    <http://www.argus-project.eu/resource/>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>
PREFIX rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?site (COUNT(?sensor) AS ?count)
WHERE {
  ?observationcollection a sosa:ObservationCollection .
    ?observationcollection argus:hasSite ?site .
    ?site a argus:Site .
    OPTIONAL { ?site rdfs:label ?Site_label . }
  OPTIONAL {
    ?observationcollection sosa:madeBySensor ?sensor .
    ?sensor a sosa:Sensor .
    OPTIONAL { ?sensor rdfs:label ?Sensor_label . }
  }
}
