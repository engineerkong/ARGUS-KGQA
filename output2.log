[Step 3] SPARQL query:
PREFIX sosa:  <http://www.w3.org/ns/sosa/>
PREFIX argus: <http://www.argus-project.eu/ontology/>
PREFIX ex:    <http://www.argus-project.eu/resource/>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>
PREFIX rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?site (MAX(?observationcollection) AS ?max)
WHERE {
  ?observationcollection a sosa:ObservationCollection .
  OPTIONAL {
    ?observationcollection argus:hasSite ?argus:site .
    ?argus:site a argus:Site .
    OPTIONAL { ?argus:site rdfs:label ?Site_label . }
  }
}
GROUP BY ?site
