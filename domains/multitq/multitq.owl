<?xml version="1.0"?>
<!-- MultiTQ (ICEWS05-15) as a HeriKGQA domain: one Event per (subject, relation, object, date)
     quadruple. An Event is also a sosa:Observation carrying sosa:resultTime, so the temporal
     layer (resultTime filters, time buckets, data window) applies unchanged. -->
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#">

  <owl:Ontology rdf:about="http://herikgqa.org/multitq/ontology"/>

  <owl:Class rdf:about="http://herikgqa.org/multitq/ontology#Event">
    <rdfs:label>Event</rdfs:label>
    <rdfs:comment>One dated political event: an Actor did eventType to a Recipient on resultTime (a day).</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://herikgqa.org/multitq/ontology#Actor">
    <rdfs:label>Actor</rdfs:label>
    <rdfs:comment>An entity (person, country, organisation, group) in the subject role of an Event.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://herikgqa.org/multitq/ontology#Recipient">
    <rdfs:label>Recipient</rdfs:label>
    <rdfs:comment>An entity in the object role of an Event (the same entity can also be an Actor elsewhere).</rdfs:comment>
  </owl:Class>

  <owl:ObjectProperty rdf:about="http://herikgqa.org/multitq/ontology#actor">
    <rdfs:domain rdf:resource="http://herikgqa.org/multitq/ontology#Event"/>
    <rdfs:range rdf:resource="http://herikgqa.org/multitq/ontology#Actor"/>
    <rdfs:label>who did it</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://herikgqa.org/multitq/ontology#recipient">
    <rdfs:domain rdf:resource="http://herikgqa.org/multitq/ontology#Event"/>
    <rdfs:range rdf:resource="http://herikgqa.org/multitq/ontology#Recipient"/>
    <rdfs:label>to whom it was done</rdfs:label>
  </owl:ObjectProperty>

  <owl:DatatypeProperty rdf:about="http://herikgqa.org/multitq/ontology#eventType">
    <rdfs:domain rdf:resource="http://herikgqa.org/multitq/ontology#Event"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>what was done (one of the listed event types)</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/sosa/resultTime">
    <rdfs:domain rdf:resource="http://herikgqa.org/multitq/ontology#Event"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label>the day of the event</rdfs:label>
  </owl:DatatypeProperty>

</rdf:RDF>
