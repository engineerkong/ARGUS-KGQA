<?xml version="1.0"?>
<rdf:RDF
     xmlns="http://www.argus-project.eu/ontology/"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:sosa="http://www.w3.org/ns/sosa/"
     xmlns:panoptes="http://www.argus-project.eu/panoptes#"
     xml:base="http://www.argus-project.eu/ontology/">

  <owl:Ontology rdf:about="http://www.argus-project.eu/ontology">
    <dc:title>ARGUS Sensor Readings Ontology Extension</dc:title>
    <dc:creator>ARGUS Project Consortium</dc:creator>
    <dc:description>
      Extension of the ARGUS Panoptes ontology defining sensor-reading classes
      and properties used in the ARGUS IoT monitoring platform.  These terms
      complement the core Panoptes ontology (panoptes3.owl) and reuse the
      W3C SOSA/SSN vocabulary for observations and sensors.
    </dc:description>
    <owl:versionInfo>0.1</owl:versionInfo>
    <owl:imports rdf:resource="http://www.argus-project.eu/panoptes"/>
    <owl:imports rdf:resource="http://www.w3.org/ns/sosa/"/>
  </owl:Ontology>

  <!-- =========================================================== -->
  <!-- Classes                                                      -->
  <!-- =========================================================== -->

  <!-- =========================================================== -->
  <!-- SOSA classes — local declarations for completeness           -->
  <!-- (Originals defined in http://www.w3.org/ns/sosa/)            -->
  <!-- =========================================================== -->

  <owl:Class rdf:about="http://www.w3.org/ns/sosa/ObservationCollection">
    <rdfs:label>Observation Collection</rdfs:label>
    <rdfs:comment>A collection of observations from a single sensor reading event.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://www.w3.org/ns/sosa/Observation">
    <rdfs:label>Observation</rdfs:label>
    <rdfs:comment>A single measured value within a reading.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://www.w3.org/ns/sosa/Sensor">
    <rdfs:label>Sensor</rdfs:label>
    <rdfs:comment>A physical sensor device.</rdfs:comment>
  </owl:Class>

  <!-- =========================================================== -->
  <!-- ARGUS extension classes                                      -->
  <!-- =========================================================== -->

  <!-- Site: a geographic monitoring location (e.g. baltanas, lucretili) -->
  <owl:Class rdf:about="Site">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
    <rdfs:label>Site</rdfs:label>
    <rdfs:comment>A geographic monitoring site in the ARGUS network.</rdfs:comment>
  </owl:Class>

  <!-- Node: a sensor node that groups multiple sensors at a site -->
  <owl:Class rdf:about="Node">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Platform"/>
    <rdfs:label>Node</rdfs:label>
    <rdfs:comment>A sensor node (hardware unit) hosting one or more sensors.</rdfs:comment>
  </owl:Class>

  <!-- ObservedProperty: the physical quantity being measured -->
  <owl:Class rdf:about="ObservedProperty">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/ObservableProperty"/>
    <rdfs:label>Observed Property</rdfs:label>
    <rdfs:comment>A physical quantity measured by a sensor (e.g. temperature, voltage, displacement).</rdfs:comment>
  </owl:Class>

  <!-- EngineeringUnit: a calibrated/converted measurement unit -->
  <owl:Class rdf:about="EngineeringUnit">
    <rdfs:label>Engineering Unit</rdfs:label>
    <rdfs:comment>A calibrated engineering unit applied to raw sensor readings (e.g. "Temperature (C)", "Rainfall (mm)").</rdfs:comment>
  </owl:Class>

  <!-- =========================================================== -->
  <!-- Object Properties                                            -->
  <!-- =========================================================== -->

  <!-- ObservationCollection -> Site -->
  <owl:ObjectProperty rdf:about="hasSite">
    <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
    <rdfs:range rdf:resource="Site"/>
    <rdfs:label>has site</rdfs:label>
  </owl:ObjectProperty>

  <!-- ObservationCollection -> Node -->
  <owl:ObjectProperty rdf:about="hasNode">
    <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
    <rdfs:range rdf:resource="Node"/>
    <rdfs:label>has node</rdfs:label>
  </owl:ObjectProperty>

  <!-- ObservationCollection -> Observation -->
  <owl:ObjectProperty rdf:about="hasObservation">
    <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
    <rdfs:label>has observation</rdfs:label>
  </owl:ObjectProperty>

  <!-- ObservationCollection -> EngineeringUnit -->
  <owl:ObjectProperty rdf:about="hasEngineeringUnit">
    <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
    <rdfs:range rdf:resource="EngineeringUnit"/>
    <rdfs:label>has engineering unit</rdfs:label>
  </owl:ObjectProperty>

  <!-- =========================================================== -->
  <!-- SOSA properties — local declarations with domain/range       -->
  <!-- (Originals defined in http://www.w3.org/ns/sosa/)            -->
  <!-- =========================================================== -->

  <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/madeBySensor">
    <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
    <rdfs:label>made by sensor</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/observedProperty">
    <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
    <rdfs:range rdf:resource="ObservedProperty"/>
    <rdfs:label>observed property</rdfs:label>
  </owl:ObjectProperty>

  <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/sosa/hasSimpleResult">
    <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>has simple result</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/sosa/resultTime">
    <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label>result time</rdfs:label>
  </owl:DatatypeProperty>

  <!-- =========================================================== -->
  <!-- Datatype Properties — ObservationCollection                  -->
  <!-- =========================================================== -->

  <owl:DatatypeProperty rdf:about="readingType">
    <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>reading type</rdfs:label>
    <rdfs:comment>Category of the reading, e.g. "reading" or "eng_units".</rdfs:comment>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="deviceGroupId">
    <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>device group ID</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="topic">
    <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>MQTT topic</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="topicId">
    <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>topic ID</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="rawJson">
    <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>raw JSON payload</rdfs:label>
  </owl:DatatypeProperty>

  <!-- =========================================================== -->
  <!-- Datatype Properties — Node                                   -->
  <!-- =========================================================== -->

  <owl:DatatypeProperty rdf:about="nodeId">
    <rdfs:domain rdf:resource="Node"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>node ID</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="nodeName">
    <rdfs:domain rdf:resource="Node"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>node name</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="nodeModel">
    <rdfs:domain rdf:resource="Node"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>node model</rdfs:label>
  </owl:DatatypeProperty>

  <!-- =========================================================== -->
  <!-- Datatype Properties — Sensor (extends sosa:Sensor)           -->
  <!-- =========================================================== -->

  <owl:DatatypeProperty rdf:about="sensorId">
    <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>sensor ID</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="sensorModel">
    <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>sensor model</rdfs:label>
  </owl:DatatypeProperty>

  <!-- =========================================================== -->
  <!-- Datatype Properties — EngineeringUnit                        -->
  <!-- =========================================================== -->

  <owl:DatatypeProperty rdf:about="engineeringUnitId">
    <rdfs:domain rdf:resource="EngineeringUnit"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>engineering unit ID</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="engineeringUnitCustom">
    <rdfs:domain rdf:resource="EngineeringUnit"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>engineering unit custom label</rdfs:label>
    <rdfs:comment>Human-readable label such as "Temperature (C)" or "Rainfall (mm)".</rdfs:comment>
  </owl:DatatypeProperty>

  <!-- =========================================================== -->
  <!-- Datatype Properties — Observation                            -->
  <!-- =========================================================== -->

  <owl:DatatypeProperty rdf:about="unit">
    <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>unit</rdfs:label>
    <rdfs:comment>Short unit string for the observation value, e.g. "Hz", "mm".</rdfs:comment>
  </owl:DatatypeProperty>

  <!-- =========================================================== -->
  <!-- Governance classes — local stubs for the panoptes3.owl       -->
  <!-- classes that the /threats, /policies, /decisions, /assets    -->
  <!-- API endpoints instantiate. Only these 4 of panoptes3.owl's   -->
  <!-- ~18 classes have instances, so they are stubbed here (not    -->
  <!-- imported wholesale) to keep the prompt-facing schema small — -->
  <!-- same rationale as SCHEMA_OWL_FILES in ontology_schema.py.    -->
  <!-- =========================================================== -->

  <owl:Class rdf:about="http://www.argus-project.eu/panoptes#Asset">
    <rdfs:label>Asset</rdfs:label>
    <rdfs:comment>A monitored heritage asset (site, monument) — one per ARGUS pilot.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://www.argus-project.eu/panoptes#Policy">
    <rdfs:label>Policy</rdfs:label>
    <rdfs:comment>An expert-rule threshold from the AD-RT anomaly-detection engine (RT/rules.py), one per monitored condition per site.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://www.argus-project.eu/panoptes#Threat">
    <rdfs:label>Threat</rdfs:label>
    <rdfs:comment>A named category of risk to an asset (e.g. moisture-related material stability).</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://www.argus-project.eu/panoptes#Decision">
    <rdfs:label>Decision</rdfs:label>
    <rdfs:comment>A recommended response action for a threat scenario.</rdfs:comment>
  </owl:Class>

  <!-- Policy -->
  <owl:ObjectProperty rdf:about="appliesToSite">
    <rdfs:domain rdf:resource="http://www.argus-project.eu/panoptes#Policy"/>
    <rdfs:range rdf:resource="Site"/>
    <rdfs:label>applies to site</rdfs:label>
  </owl:ObjectProperty>

  <owl:DatatypeProperty rdf:about="ruleId">
    <rdfs:domain rdf:resource="http://www.argus-project.eu/panoptes#Policy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>rule ID</rdfs:label>
    <rdfs:comment>AD-RT rule identifier, e.g. "R1a_rain_1h".</rdfs:comment>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="thresholdValue">
    <rdfs:domain rdf:resource="http://www.argus-project.eu/panoptes#Policy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>threshold value</rdfs:label>
    <rdfs:comment>Numeric threshold for the rule, when it has exactly one. Multi-parameter rules also carry thresholdJson.</rdfs:comment>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="thresholdJson">
    <rdfs:domain rdf:resource="http://www.argus-project.eu/panoptes#Policy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>threshold overrides (JSON)</rdfs:label>
    <rdfs:comment>Full threshold_overrides dict for rules with more than one parameter.</rdfs:comment>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="threatName">
    <rdfs:domain rdf:resource="http://www.argus-project.eu/panoptes#Policy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>threat name</rdfs:label>
    <rdfs:comment>Free-text name of the threat this policy guards against (not yet a linked Threat instance in the source API).</rdfs:comment>
  </owl:DatatypeProperty>

  <!-- Asset -->
  <owl:ObjectProperty rdf:about="atSite">
    <rdfs:domain rdf:resource="http://www.argus-project.eu/panoptes#Asset"/>
    <rdfs:range rdf:resource="Site"/>
    <rdfs:label>at site</rdfs:label>
  </owl:ObjectProperty>

  <owl:DatatypeProperty rdf:about="assetCode">
    <rdfs:domain rdf:resource="http://www.argus-project.eu/panoptes#Asset"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>asset code</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="pilotNumber">
    <rdfs:domain rdf:resource="http://www.argus-project.eu/panoptes#Asset"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label>pilot number</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="sourceUrl">
    <rdfs:domain rdf:resource="http://www.argus-project.eu/panoptes#Asset"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>source URL</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="country">
    <rdfs:domain rdf:resource="http://www.argus-project.eu/panoptes#Asset"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>country</rdfs:label>
  </owl:DatatypeProperty>

  <!-- Decision -->
  <owl:DatatypeProperty rdf:about="urgency">
    <rdfs:domain rdf:resource="http://www.argus-project.eu/panoptes#Decision"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>urgency</rdfs:label>
  </owl:DatatypeProperty>

  <!-- Threat -->
  <owl:DatatypeProperty rdf:about="threatLevel">
    <rdfs:domain rdf:resource="http://www.argus-project.eu/panoptes#Threat"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>threat level</rdfs:label>
    <rdfs:comment>Severity, e.g. "High", "Medium".</rdfs:comment>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="assetDescription">
    <rdfs:domain rdf:resource="http://www.argus-project.eu/panoptes#Asset"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>description</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="policyDescription">
    <rdfs:domain rdf:resource="http://www.argus-project.eu/panoptes#Policy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>description</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="threatDescription">
    <rdfs:domain rdf:resource="http://www.argus-project.eu/panoptes#Threat"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>description</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="decisionDescription">
    <rdfs:domain rdf:resource="http://www.argus-project.eu/panoptes#Decision"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>description</rdfs:label>
  </owl:DatatypeProperty>

  <!-- =========================================================== -->
  <!-- Device/Instrument hierarchy — mirrors argus_live_kg's        -->
  <!-- (kgqa/argus_live_kg/argus_live.obda) class shape, so a        -->
  <!-- question phrased in that vocabulary (device/instrument       -->
  <!-- type, installed-on-asset chain) resolves the same way        -->
  <!-- against our own Postgres-backed data. MeasurementProtocol    -->
  <!-- and Monitoring are deliberately not mirrored here — the      -->
  <!-- ARGUS API carries no equivalent field, so those two would    -->
  <!-- have to be fabricated rather than derived. "Asset" is also   -->
  <!-- deliberately not re-declared under argus: here — panoptes:   -->
  <!-- Asset already owns that local name in this schema; adding    -->
  <!-- a second same-named class would silently collide in          -->
  <!-- ontology_schema.py's CLASS_MAP (see the earlier bare          -->
  <!-- "?policy a Policy" bug). AssetState links to panoptes:Asset   -->
  <!-- instead, where the site has one.                              -->
  <!-- =========================================================== -->

  <owl:Class rdf:about="Location">
    <rdfs:label>Location</rdfs:label>
    <rdfs:comment>A monitored site's location, in the argus_live_kg vocabulary — one per Site.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="AssetState">
    <rdfs:label>Asset State</rdfs:label>
    <rdfs:comment>A monitored site's state at a point in time — one per Site here (readings aren't modelled as asset-state transitions).</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="DeviceType">
    <rdfs:label>Device Type</rdfs:label>
    <rdfs:comment>A node's hardware model (Node.nodeModel), e.g. a logger box model.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="Device">
    <rdfs:label>Device</rdfs:label>
    <rdfs:comment>A physical node/logger box — one per Node.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="InstalledDevice">
    <rdfs:label>Installed Device</rdfs:label>
    <rdfs:comment>A Device as installed at a site's AssetState.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="InstrumentType">
    <rdfs:label>Instrument Type</rdfs:label>
    <rdfs:comment>A sensor's hardware model (Sensor.sensorModel).</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="Instrument">
    <rdfs:label>Instrument</rdfs:label>
    <rdfs:comment>A physical sensor — one per Sensor.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="InstalledInstrument">
    <rdfs:label>Installed Instrument</rdfs:label>
    <rdfs:comment>An Instrument as installed on an InstalledDevice.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="PhysicalQuantity">
    <rdfs:label>Physical Quantity</rdfs:label>
    <rdfs:comment>Same individuals as ObservedProperty, dual-typed for the argus_live_kg vocabulary.</rdfs:comment>
  </owl:Class>

  <owl:ObjectProperty rdf:about="hasLocation">
    <rdfs:domain rdf:resource="AssetState"/>
    <rdfs:range rdf:resource="Location"/>
    <rdfs:label>has location</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="stateOfAsset">
    <rdfs:domain rdf:resource="AssetState"/>
    <rdfs:range rdf:resource="http://www.argus-project.eu/panoptes#Asset"/>
    <rdfs:label>state of asset</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="deviceType">
    <rdfs:domain rdf:resource="Device"/>
    <rdfs:range rdf:resource="DeviceType"/>
    <rdfs:label>device type</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="installsDevice">
    <rdfs:domain rdf:resource="InstalledDevice"/>
    <rdfs:range rdf:resource="Device"/>
    <rdfs:label>installs device</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="installedOnAssetState">
    <rdfs:domain rdf:resource="InstalledDevice"/>
    <rdfs:range rdf:resource="AssetState"/>
    <rdfs:label>installed on asset state</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="instrumentType">
    <rdfs:domain rdf:resource="Instrument"/>
    <rdfs:range rdf:resource="InstrumentType"/>
    <rdfs:label>instrument type</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="installsInstrument">
    <rdfs:domain rdf:resource="InstalledInstrument"/>
    <rdfs:range rdf:resource="Instrument"/>
    <rdfs:label>installs instrument</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="installedOnDevice">
    <rdfs:domain rdf:resource="InstalledInstrument"/>
    <rdfs:range rdf:resource="InstalledDevice"/>
    <rdfs:label>installed on device</rdfs:label>
  </owl:ObjectProperty>

</rdf:RDF>
