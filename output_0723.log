────────────────────────────────────────────────────────────
[Step 2] SPARQL query:
PREFIX sosa:  <http://www.w3.org/ns/sosa/>
PREFIX argus: <http://www.argus-project.eu/ontology/>
PREFIX ex:    <http://www.argus-project.eu/resource/>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>
PREFIX rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?site_label (COUNT(DISTINCT ?observationcollection) AS ?count)
WHERE {
  ?observationcollection a sosa:ObservationCollection .
    ?observationcollection argus:hasSite ?site .
    OPTIONAL { ?site rdfs:label ?site_label . }
}
GROUP BY ?site_label
