    },
    {
      "class": "Site",
      "via": "hasSite",
      "direction": "outgoing",
      "return_properties": [
        "label"
      ],
      "filters": []
    }
  ],
  "aggregation": null,
  "order_by": {
    "variable": "ObservationCollection.resultTime",
    "direction": "DESC"
  },
  "limit": 10,
  "explanation": "Retrieve the 10 most recent individual readings (Observations) ordered by their collection's resultTime."
}

────────────────────────────────────────────────────────────
[Step 2] SPARQL query:
PREFIX sosa:  <http://www.w3.org/ns/sosa/>
PREFIX argus: <http://www.argus-project.eu/ontology/>
PREFIX ex:    <http://www.argus-project.eu/resource/>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>
PREFIX rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT DISTINCT ?hassimpleresult ?observationcollection_resulttime ?site_label ?observedproperty_label
WHERE {
  {
  SELECT ?observation ?hassimpleresult ?observationcollection_resulttime
  WHERE {
    ?observation a sosa:Observation .
    OPTIONAL { ?observation sosa:hasSimpleResult ?hassimpleresult . }
    ?observationcollection argus:hasObservation ?observation .
    ?observationcollection sosa:resultTime ?observationcollection_resulttime .
  }
    ORDER BY DESC(?observationcollection_resulttime)
  LIMIT 10
  }
  OPTIONAL {
    ?observationcollection argus:hasObservation ?observation .
    OPTIONAL { ?observationcollection sosa:resultTime ?observationcollection_resulttime . }
  }
  OPTIONAL {
    ?observationcollection argus:hasSite ?site .
    OPTIONAL { ?site rdfs:label ?site_label . }
  }
  OPTIONAL {
    ?observation sosa:observedProperty ?observedproperty .
    OPTIONAL { ?observedproperty rdfs:label ?observedproperty_label . }
  }
}
