PREFIX sosa:  <http://www.w3.org/ns/sosa/>
PREFIX argus: <http://www.argus-project.eu/ontology/>
PREFIX ex:    <http://www.argus-project.eu/resource/>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>
PREFIX rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT DISTINCT ?sensor ?label ?sensorid ?sensormodel ?site_label
WHERE {
  ?sensor a sosa:Sensor .
  OPTIONAL { ?sensor rdfs:label ?label . }
  OPTIONAL { ?sensor argus:sensorId ?sensorid . }
  OPTIONAL { ?sensor argus:sensorModel ?sensormodel . }
    ?observationcollection sosa:madeBySensor ?sensor .
    ?observationcollection argus:hasSite ?site .
    OPTIONAL { ?site rdfs:label ?site_label . }
    ?site rdfs:label ?_jf_label .
      FILTER(LCASE(STR(?_jf_label)) = LCASE("baltanas"))
}
